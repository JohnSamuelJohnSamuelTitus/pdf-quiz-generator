# LearnSphere Environment Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=learnsphere-super-secure-jwt-secret-cse279-academic-2026

# Local Relational Database Configuration
SQLITE_DB_PATH=./data/learnsphere.db

# Optional Supabase Configuration (Leave blank to use built-in SQLite engine)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public API Ecosystem Configuration (Optional - All 8 APIs have free/open access)
# 1. Wikipedia REST API: No key required
# 2. Open Library Subjects API: No key required
# 3. Open Trivia Database API: No key required
# 4. Free Dictionary API: No key required
# 5. OpenAlex Scholarly API: (Optional polite pool email or premium key)
OPENALEX_API_KEY=
OPENALEX_POLITE_EMAIL=
# 6. arXiv Preprints API: No key required
# 7. Project Gutenberg (Gutendex): No key required
# 8. MathJS Computational Engine: No key required

# Optional AI Provider Configuration (Optional - provider independent fallback is built-in)
AI_PROVIDER=none
AI_API_KEY=
